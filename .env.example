# Copiar a .env.local. Valores locales los imprime `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-publica-anon-o-publishable
# Solo servidor. Nunca exponer en el navegador ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=clave-secreta-service-role
# URL pública de la aplicación (enlaces de invitación y recuperación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
